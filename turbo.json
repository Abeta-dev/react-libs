{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "cache": true
    },
    "check:directives": {
      "dependsOn": ["build"]
    },
    "check:size": {
      "dependsOn": ["build"]
    },
    "check:truth": {
      "dependsOn": ["build"]
    },
    "//#build": {
      "dependsOn": ["@abeta.dev/auth#build"],
      "outputs": ["dist/**"]
    },
    "//#test": {
      "dependsOn": ["//#build"],
      "outputs": ["coverage/**"]
    },
    "//#lint": {
      "cache": true
    }
  }
}
