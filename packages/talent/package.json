{
  "name": "@abeta.dev/talent",
  "version": "0.22.0",
  "description": "Interactive assessment, candidate evaluation, checkpoint runners, and kanban pipeline UI for React 19.",
  "keywords": [
    "react",
    "react-19",
    "talent",
    "assessment",
    "quiz",
    "certificate",
    "proof-of-work",
    "kanban",
    "hiring",
    "edtech",
    "lms",
    "checkpoint",
    "tailwind-v4",
    "typescript",
    "abeta"
  ],
  "author": "abeta-dev <contact@abeta.dev>",
  "license": "MIT",
  "homepage": "https://abeta-dev.github.io/react-libs/",
  "bugs": {
    "url": "https://github.com/Abeta-dev/react-libs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abeta-dev/react-libs.git",
    "directory": "packages/talent"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@abeta.dev/ui": "^0.22.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0"
  },
  "peerDependencies": {
    "canvas-confetti": "^1.9.4",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "canvas-confetti": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "canvas-confetti": "^1.9.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
