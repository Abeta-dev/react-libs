{
  "name": "@abeta.dev/india",
  "version": "0.21.0",
  "description": "India statutory validation, FinTech cards, GSTIN/PAN/IFSC, UPI QR generation, and bilingual support for React 19.",
  "keywords": [
    "india",
    "gst",
    "gstin",
    "pan",
    "ifsc",
    "fssai",
    "upi",
    "upi-qr",
    "npci",
    "fintech",
    "invoicing",
    "lakhs",
    "crores",
    "react",
    "react-19",
    "rsc",
    "typescript",
    "abeta"
  ],
  "author": "abeta-dev <contact@abeta.dev>",
  "license": "MIT",
  "homepage": "https://abeta-dev.github.io/react-libs/",
  "bugs": {
    "url": "https://github.com/Abeta-dev/react-libs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abeta-dev/react-libs.git",
    "directory": "packages/india"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@abeta.dev/ui": "^0.21.0",
    "lucide-react": "^1.75.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@abeta.dev/ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@abeta.dev/ui": "^0.21.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^1.75.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
