{
  "name": "@abeta.dev/auth",
  "version": "0.2.1",
  "description": "Backend-agnostic React 19 authentication UI library with Google & LinkedIn 3PL, email/password, and concurrent-safe token refresh.",
  "keywords": [
    "react",
    "react19",
    "auth",
    "authentication",
    "oauth",
    "google-login",
    "linkedin-login",
    "refresh-token",
    "tailwind",
    "design-system"
  ],
  "author": "Umesh Gupta <umesh@abeta.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abeta-dev/react-libs.git",
    "directory": "packages/auth"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core/use-click-backpressure": {
      "import": {
        "types": "./dist/core/use-click-backpressure.d.ts",
        "default": "./dist/core/use-click-backpressure.js"
      },
      "require": {
        "types": "./dist/core/use-click-backpressure.d.cts",
        "default": "./dist/core/use-click-backpressure.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "core/use-click-backpressure": [
        "./dist/core/use-click-backpressure.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "check:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
