{
  "name": "@abeta.dev/analytics",
  "version": "0.22.0",
  "description": "Zero-bloat behavioral analytics engine with pluggable adapters (Console, HTTP, Google Analytics, Mixpanel), automatic PII sanitization, offline batching, and optional React 18/19 hooks.",
  "keywords": [
    "analytics",
    "telemetry",
    "tracking",
    "pii-sanitization",
    "dom-tracker",
    "google-analytics",
    "mixpanel",
    "react",
    "react-19",
    "rsc",
    "node",
    "typescript",
    "abeta"
  ],
  "author": "abeta-dev <contact@abeta.dev>",
  "license": "MIT",
  "homepage": "https://abeta-dev.github.io/react-libs/",
  "bugs": {
    "url": "https://github.com/Abeta-dev/react-libs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abeta-dev/react-libs.git",
    "directory": "packages/analytics"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
