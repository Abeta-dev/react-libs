      "deprecatedSince": "0.18.0",
      "removeIn": "1.0.0",
      "status": "active",
      "replacement": "AmountSummaryItem.taxRate",
      "migrationDoc": "MIGRATION.md#upgrading-to-v0210",
      "fileGlobs": [
        "packages/ui/src/data-display/amount-summary-card.tsx",
        "src/components/ui/data-display/amount-summary-card.tsx"
